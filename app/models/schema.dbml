// Целевая структура, а не миграция старой БД.

// DBML для просмотра в dbdiagram. Временные типы ориентированы на PostgreSQL.

// Все интервалы полуоткрытые: [начало, конец).

// updated_at и version обновляет приложение: DEFAULT не делает это при UPDATE.

// Таблицы импорта, ИИ, уведомлений и звонков можно реализовать после ядра.

// Межтабличные бизнес-проверки перечислены в notes и в consultations_v2_notes.md.

//https://dbdiagram.io/d/6ab0cd59bd4073ff5125a693

Project consultations_v2 {

  database_type: 'PostgreSQL'

  Note: 'Учебные занятия, бронь аудитории на пару и консультации разделены. Одна бронь принадлежит преподавателю и обслуживает несколько консультаций.'

}



// ---------- ЛЮДИ И АККАУНТЫ ----------



Table people {

  id int [pk, increment]

  full_name text [not null]

  Note: 'Человек может присутствовать в расписании без аккаунта. ФИО не уникально: однофамильцев не объединять автоматически.'

}



Table users {

  id int [pk, increment]

  person_id int [not null, unique, ref: - people.id]

  login varchar(150) [not null, unique]

  password_hash text

  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Только аккаунт и авторизация. NULL password_hash допустим при отдельно реализованном внешнем входе, не означает вход без пароля.'

}



Table user_roles {

  user_id int [not null, ref: > users.id]

  role varchar(20) [not null, check: `role IN ('student', 'teacher', 'admin')`]

  indexes {

    (user_id, role) [pk]

  }

}



Table teachers {

  id int [pk, increment]

  person_id int [not null, unique, ref: - people.id]

  department_id int [ref: > departments.id]

}



Table students {

  id int [pk, increment]

  person_id int [not null, unique, ref: - people.id]

  group_id int [ref: > academic_groups.id]

  Note: 'Одна текущая академическая группа. NULL означает, что группа пока не определена.'

}



// ---------- СПРАВОЧНИКИ ----------



Table departments {

  id int [pk, increment]

  name text [not null]

  office_classroom_id int [ref: > classrooms.id]

  Note: 'Кафедра. office_classroom_id — справочный кабинет, а не постоянная бронь.'

}



Table academic_groups {

  id int [pk, increment]

  name varchar(100) [not null]

  admission_year smallint // год поступления

  indexes {

    name

  }

}



Table buildings {

  id int [pk, increment]

  name text [not null]

  address text

}



Table classrooms {

  id int [pk, increment]

  building_id int [not null, ref: > buildings.id]

  name varchar(100) [not null]

  capacity int [check: `capacity > 0`]

  room_type varchar(50)

  board_type varchar(50)

  has_screen boolean

  info text

  indexes {

    (building_id, name) [unique]

  }

  Note: 'NULL capacity/has_screen — неизвестно, а не ноль/нет. Неизвестную вместимость нельзя считать подтвержденной пригодностью аудитории.'

}



Table subjects {

  id int [pk, increment]

  name text [not null]

  department_id int [ref: > departments.id]

}



Table teacher_subjects {

  teacher_id int [not null, ref: > teachers.id]

  subject_id int [not null, ref: > subjects.id]

  indexes {

    (teacher_id, subject_id) [pk]

  }

  Note: 'Справочный список дисциплин преподавателя, не расписание и не список студентов.'

}



// ---------- ПАРЫ И УЧЕБНОЕ РАСПИСАНИЕ ----------



Table bell_schedules {

  id int [pk, increment]

  name text [not null]

  timezone varchar(100) [not null]

  Note: 'Название сетки пар и часовой пояс IANA. Возможны разные сетки для подразделений или периодов обучения.'

}



Table period_slots {

  id int [pk, increment]

  bell_schedule_id int [not null, ref: > bell_schedules.id]

  slot_date date [not null]

  period_number smallint [not null, check: `period_number > 0`]

  starts_at timestamptz [not null]

  ends_at timestamptz [not null]

  indexes {

    (bell_schedule_id, slot_date, period_number) [unique]

    starts_at

  }

  checks {

    `ends_at > starts_at`

  }

  Note: 'Одна конкретная полная пара на дату, а не недельный шаблон. Приложение проверяет локальную дату в timezone сетки. Используемые слоты не менять без проверки зависимых броней.'

}



Table timetable_events {

  id int [pk, increment]

  subject_id int [ref: > subjects.id]

  classroom_id int [ref: > classrooms.id]

  title text

  kind varchar(20) [not null, check: `kind IN ('lecture', 'practice', 'lab', 'exam', 'retake', 'other')`]

  starts_at timestamptz [not null]

  ends_at timestamptz [not null]

  status varchar(20) [not null, default: 'scheduled', check: `status IN ('scheduled', 'cancelled')`]

  visibility varchar(20) [not null, check: `visibility IN ('shared', 'personal')`]

  owner_user_id int [ref: > users.id]

  created_by int [ref: > users.id]

  version int [not null, default: 1, check: `version > 0`] //Счётчик изменения данных

  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {

    (classroom_id, starts_at)

    (owner_user_id, starts_at)

    starts_at

  }

  checks {

    `ends_at > starts_at`

    `(visibility = 'shared' AND owner_user_id IS NULL) OR (visibility = 'personal' AND owner_user_id IS NOT NULL)`

  }

  Note: 'Только учебные/внешние события, не консультации. Интервал отражает занятость по расписанию вуза. Личный импорт не меняет общую занятость кабинетов. Внешние конфликтующие сведения разрешено сохранить для последующего разрешения конфликта.'

}



Table timetable_event_teachers {

  event_id int [not null, ref: > timetable_events.id]

  teacher_id int [not null, ref: > teachers.id]

  indexes {

    (event_id, teacher_id) [pk]

    teacher_id

  }

}



Table timetable_event_groups {

  event_id int [not null, ref: > timetable_events.id]

  group_id int [not null, ref: > academic_groups.id]

  indexes {

    (event_id, group_id) [pk]

    group_id

  }

}



// ---------- БРОНЬ АУДИТОРИИ ----------



Table room_reservations {

  id int [pk, increment]

  teacher_id int [not null, ref: > teachers.id]

  classroom_id int [not null, ref: > classrooms.id]

  period_slot_id int [not null, ref: > period_slots.id]

  host_event_id int [ref: > timetable_events.id]

  status varchar(20) [not null, default: 'active', check: `status IN ('active', 'conflicted', 'released')`]

  created_by int [not null, ref: > users.id]

  version int [not null, default: 1, check: `version > 0`]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {

    (id, teacher_id) [unique]

    (classroom_id, period_slot_id)

    (teacher_id, status)

  }

  Note: 'Кабинет удерживается на ВЕСЬ period_slot. Одна бронь — несколько консультаций одного преподавателя. host_event_id: подтвержденное использование кабинета внутри своего занятия, не отмена занятия. active/conflicted учитываются как местная бронь; released — история. Пересечения проверять по реальному времени, в том числе между разными сетками пар, с защитой от конкурентных записей.'

}



// ---------- КОНСУЛЬТАЦИИ И ЗАПИСЬ ----------



Table consultations {

  id int [pk, increment]

  teacher_id int [not null, ref: > teachers.id]

  subject_id int [ref: > subjects.id]

  reservation_id int

  title text [not null]

  description text

  format varchar(20) [not null, check: `format IN ('onsite', 'online', 'hybrid')`]

  starts_at timestamptz [not null]

  ends_at timestamptz [not null]

  max_students int [not null, check: `max_students > 0`]

  audience_mode varchar(30) [not null, default: 'all_students', check: `audience_mode IN ('all_students', 'selected_groups')`]

  status varchar(20) [not null, default: 'draft', check: `status IN ('draft', 'published', 'cancelled', 'completed')`]

  registration_opens_at timestamptz

  registration_closes_at timestamptz

  created_by int [not null, ref: > users.id]

  version int [not null, default: 1, check: `version > 0`]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {

    (teacher_id, starts_at)

    (status, starts_at)

    reservation_id

  }

  checks {

    `ends_at > starts_at`

    `(format = 'online' AND reservation_id IS NULL) OR (format IN ('onsite', 'hybrid') AND (reservation_id IS NOT NULL OR status IN ('draft', 'cancelled')))`

    `registration_opens_at IS NULL OR registration_closes_at IS NULL OR registration_opens_at < registration_closes_at`

    `registration_opens_at IS NULL OR registration_opens_at < starts_at`

    `registration_closes_at IS NULL OR registration_closes_at <= starts_at`

  }

  Note: 'Фактическое время консультации. Аудитория определяется через бронь. Для очной/гибридной публикации нужны действующая подходящая бронь и полное попадание в ее пару. Один общий интервал для всех мест; индивидуальные приемы — отдельные консультации с max_students=1. Изменение общей брони затрагивает все связанные консультации.'

}



// Составной FK запрещает привязать консультацию к броне другого преподавателя.

Ref: consultations.(reservation_id, teacher_id) > room_reservations.(id, teacher_id)



Table consultation_allowed_groups {

  consultation_id int [not null, ref: > consultations.id]

  group_id int [not null, ref: > academic_groups.id]

  indexes {

    (consultation_id, group_id) [pk]

    group_id

  }

  Note: 'Ограничение доступа, а не список участников. При selected_groups пустой список запрещает запись всем и не допускается при публикации. При all_students список должен быть пуст.'

}



Table consultation_registrations {

  consultation_id int [not null, ref: > consultations.id]

  student_id int [not null, ref: > students.id]

  status varchar(20) [not null, default: 'confirmed', check: `status IN ('confirmed', 'cancelled', 'attended', 'no_show')`]

  student_question text

  registered_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  cancelled_at timestamptz

  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {

    (consultation_id, student_id) [pk]

    (consultation_id, status)

    (student_id, status)

  }

  checks {

    `(status = 'cancelled' AND cancelled_at IS NOT NULL) OR (status <> 'cancelled' AND cancelled_at IS NULL)`

  }

  Note: 'Одна текущая запись студента на консультацию. Повторная запись обновляет строку с повторной проверкой мест. Только cancelled не занимает место. Остаток мест вычисляется, отдельного счетчика нет. Проверку вместимости и запись выполнять атомарно.'

}



Table consultation_overlap_permissions {

  consultation_id int [not null, ref: > consultations.id]

  event_id int [not null, ref: > timetable_events.id]

  approved_by int [not null, ref: > users.id]

  approved_event_version int [not null, check: `approved_event_version > 0`]

  approved_consultation_version int [not null, check: `approved_consultation_version > 0`]

  approved_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  reason text

  indexes {

    (consultation_id, event_id) [pk]

  }

  Note: 'Явное разрешение преподавателя совместить конкретную консультацию с конкретным своим занятием. Не разрешает чужую бронь или пересечение двух консультаций. Разрешение действует только для подтвержденных версий события и консультации; после изменения нужны повторная проверка и подтверждение.'

}



Table consultation_requests {

  id int [pk, increment]

  student_id int [not null, ref: > students.id]

  teacher_id int [not null, ref: > teachers.id]

  subject_id int [ref: > subjects.id]

  topic text [not null]

  message text

  status varchar(20) [not null, default: 'pending', check: `status IN ('pending', 'planned', 'rejected', 'cancelled')`]

  consultation_id int [ref: > consultations.id]

  teacher_reply text

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {

    (teacher_id, status)

    student_id

  }

  checks {

    `status <> 'planned' OR consultation_id IS NOT NULL`

  }

  Note: 'Запрос организовать консультацию, не регистрация. Несколько запросов могут вести к одной консультации того же преподавателя. Студент записывается отдельно.'

}



// ---------- ДОСТУПНОСТЬ ПРЕПОДАВАТЕЛЯ ----------



Table teacher_scheduling_settings {

  teacher_id int [pk, ref: - teachers.id]

  timezone varchar(100) [not null]

  default_duration_minutes int [not null, default: 30, check: `default_duration_minutes > 0`]

  buffer_minutes int [not null, default: 0, check: `buffer_minutes >= 0`]

  min_booking_notice_minutes int [not null, default: 0, check: `min_booking_notice_minutes >= 0`]

  max_consultations_per_day int [check: `max_consultations_per_day > 0`]

  version int [not null, default: 1, check: `version > 0`]

  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Часовой пояс IANA. NULL дневного лимита — без лимита. Буфер — минимальный промежуток, без двойного сложения между двумя консультациями. Это настройки автоподбора и записи, не разрешение обходить реальную занятость. Любое изменение настроек, правил или исключений увеличивает version этого набора.'

}



Table teacher_availability_rules {

  id int [pk, increment]

  teacher_id int [not null, ref: > teacher_scheduling_settings.teacher_id]

  kind varchar(20) [not null, check: `kind IN ('available', 'unavailable', 'preferred', 'avoided')`]

  day_of_week smallint [not null, check: `day_of_week BETWEEN 1 AND 7`]

  all_day boolean [not null, default: false]

  start_time time

  end_time time

  valid_from date [not null]

  valid_to date

  weight smallint

  source_text text

  is_active boolean [not null, default: true]

  confirmed_by int [not null, ref: > users.id]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {

    (teacher_id, day_of_week)

  }

  checks {

    `valid_to IS NULL OR valid_to >= valid_from`

    `(all_day AND start_time IS NULL AND end_time IS NULL) OR (NOT all_day AND start_time IS NOT NULL AND end_time IS NOT NULL AND start_time < end_time)`

    `(kind IN ('preferred', 'avoided') AND weight IS NOT NULL AND weight BETWEEN 1 AND 10) OR (kind IN ('available', 'unavailable') AND weight IS NULL)`

  }

  Note: 'Подтвержденные недельные правила. 1=понедельник, 7=воскресенье; время локальное, valid_to включительно. available открывает окно; unavailable запрещает; preferred/avoided только ранжируют. Нет доступных окон — ИИ не считает человека доступным круглосуточно. Правила через полночь разбивать. Личные причины не показывать студентам.'

}



Table teacher_availability_exceptions {

  id int [pk, increment]

  teacher_id int [not null, ref: > teacher_scheduling_settings.teacher_id]

  kind varchar(20) [not null, check: `kind IN ('available', 'unavailable')`]

  starts_at timestamptz [not null]

  ends_at timestamptz [not null]

  source_text text

  is_active boolean [not null, default: true]

  confirmed_by int [not null, ref: > users.id]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {

    (teacher_id, starts_at)

  }

  checks {

    `ends_at > starts_at`

  }

  Note: 'Разовые разрешения/запреты. Разовый запрет сильнее разрешений. Разовое разрешение может переопределить недельный запрет, но не занятость/чужую бронь. Правила сами не переносят уже опубликованные консультации.'

}



// ---------- ИМПОРТ РАСПИСАНИЯ: ОПЦИОНАЛЬНЫЙ МОДУЛЬ ----------



Table schedule_sources {

  id int [pk, increment]

  name text [not null]

  kind varchar(20) [not null, check: `kind IN ('website', 'file', 'manual')`]

  locator text

  authority varchar(20) [not null, default: 'user_provided', check: `authority IN ('official', 'user_provided')`]

  submitted_by int [ref: > users.id]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'locator — URL или ключ файла, не содержимое и не секреты. Статус official назначает доверенная серверная логика/администратор, не модель по тексту файла. Ссылка на сайт сама по себе не гарантирует успешный импорт.'

}



Table schedule_imports {

  id int [pk, increment]

  source_id int [not null, ref: > schedule_sources.id]

  status varchar(20) [not null, default: 'pending', check: `status IN ('pending', 'review', 'applied', 'failed', 'rejected')`]

  coverage_from date

  coverage_to date

  is_complete boolean [not null, default: false]

  raw_file_key text // путь сырого файла

  draft_payload json //черновик рассписания

  reviewed_by int [ref: > users.id]

  started_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  finished_at timestamptz

  error_message text

  indexes {

    (id, source_id) [unique]

    (source_id, started_at)

  }

  checks {

    `coverage_from IS NULL OR coverage_to IS NULL OR coverage_to >= coverage_from`

  }

  Note: 'Отдельный запуск загрузки. draft_payload — распознанный черновик, не действующее расписание. Не отменять отсутствующие события по неуспешному/неполному импорту. Проверять область покрытия, роль источника и другие источники того же события.'

}



Table schedule_event_sources {

  source_id int [not null, ref: > schedule_sources.id]

  source_event_key varchar(255) [not null]

  event_id int [not null, ref: > timetable_events.id]

  last_seen_import_id int [not null]

  indexes {

    (source_id, source_event_key) [pk]

    event_id

  }

  Note: 'Одна запись источника соответствует событию; у события может быть несколько источников. Ключ должен позволять сопоставить повторный импорт после переноса. Без устойчивого внешнего ID неоднозначные совпадения требуют проверки.'

}



Ref: schedule_event_sources.(last_seen_import_id, source_id) > schedule_imports.(id, source_id)



// ---------- КОНФЛИКТЫ, ПРЕДЛОЖЕНИЯ ИИ, УВЕДОМЛЕНИЯ ----------



Table schedule_conflicts {

  id int [pk, increment]

  reservation_id int [ref: > room_reservations.id]

  consultation_id int [ref: > consultations.id]

  conflicting_event_id int [ref: > timetable_events.id]

  conflicting_consultation_id int [ref: > consultations.id]

  detected_import_id int [ref: > schedule_imports.id]

  kind varchar(30) [not null, check: `kind IN ('room_busy', 'teacher_busy', 'outside_reservation', 'availability_changed', 'source_changed')`]

  status varchar(20) [not null, default: 'open', check: `status IN ('open', 'resolved', 'dismissed')`]

  details text [not null]

  resolution_note text

  detected_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  resolved_at timestamptz

  resolved_by int [ref: > users.id]

  indexes {

    (status, detected_at)

    reservation_id

    consultation_id

  }

  checks {

    `(reservation_id IS NOT NULL AND consultation_id IS NULL) OR (reservation_id IS NULL AND consultation_id IS NOT NULL)`

    `consultation_id IS NULL OR conflicting_consultation_id IS NULL OR consultation_id <> conflicting_consultation_id`

  }

  Note: 'Одна затронутая сущность: бронь ИЛИ консультация. Конфликт брони затрагивает все консультации в ней. Не создавать повторно один и тот же открытый конфликт при каждом опросе. dismissed не делает физический конфликт безопасным: нужны проверенное исправление данных или допустимое разрешение.'

}



Table ai_proposals {

  id int [pk, increment]

  teacher_id int [not null, ref: > teachers.id]

  requested_by int [ref: > users.id]

  consultation_id int [ref: > consultations.id]

  reservation_id int [ref: > room_reservations.id]

  conflict_id int [ref: > schedule_conflicts.id]

  kind varchar(30) [not null, check: `kind IN ('availability_change', 'consultation_create', 'consultation_change', 'room_change')`]

  source_text text

  payload_version int [not null, default: 1, check: `payload_version > 0`]

  proposed_payload json [not null]

  status varchar(20) [not null, default: 'pending', check: `status IN ('pending', 'applied', 'rejected', 'obsolete')`]

  decided_by int [ref: > users.id]

  decided_at timestamptz

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {

    (teacher_id, status)

  }

  Note: 'Только черновик изменения. Payload содержит предложенные поля и версии затронутых сущностей; не произвольный SQL. Применение — после подтверждения преподавателем, проверки прав и повторной проверки условий в транзакции. Рекомендации консультаций студенту не обязаны сохраняться здесь.'

}



Table notifications {

  id int [pk, increment]

  user_id int [not null, ref: > users.id]

  consultation_id int [ref: > consultations.id]

  reservation_id int [ref: > room_reservations.id]

  kind varchar(50) [not null]

  message text [not null]

  dedupe_key varchar(255)

  read_at timestamptz

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {

    (user_id, created_at)

    (user_id, dedupe_key) [unique]

  }

  Note: 'Уведомления внутри приложения. dedupe_key предотвращает повторы одного уведомления для пользователя. Письма/push и повторные попытки доставки — отдельная реализация.'

}



// ---------- ЗВОНКИ: ОПЦИОНАЛЬНЫЙ МОДУЛЬ ----------



Table video_meetings {

  id int [pk, increment]

  consultation_id int [not null, unique, ref: - consultations.id]

  provider varchar(50) [not null]

  external_room_id varchar(255) [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {

    (provider, external_room_id) [unique]

  }

  Note: 'Метаданные видеокомнаты. Доступ выдавать участникам на сервере; постоянные секреты и токены здесь не хранить. Курсы, материалы и задания в эту версию не включены.'

}



