# Необязательные настройки: без .env приложение использует эти значения.
APP_NAME="Tutor Booking API"
DEBUG=false
# Для обращения к БД: замените password паролем пользователя PostgreSQL.
DATABASE_URL=postgresql+psycopg://tutor_app:password@localhost:5432/tutor_booking
SECRET_KEY="change-me-to-a-secure-random-secret-key"
# Настройки SMTP (если пусто, письма выводятся в консоль):
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="user@example.com"
# SMTP_PASSWORD="password"
# SMTP_FROM="noreply@example.com"
# пример, пароль qwerty123 DATABASE_URL=postgresql+psycopg://tutor_app:qwerty123@localhost:5432/tutor_booking (убрать)